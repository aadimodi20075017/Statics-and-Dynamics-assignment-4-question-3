<mujoco model="g1_hand_to_hand_toss">
  <include file="g1.xml"/>

  <!-- Genuine Earth gravity (9.81 m/s^2) and 2 ms physics step -->
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.85 0.85 0.85 1"/>

    <!-- Red apple (150 g, radius 4 cm) -->
    <body name="apple" pos="0.3 0.2 0.85">
      <freejoint name="apple_joint"/>
      <geom type="sphere" size="0.04" mass="0.15" rgba="0.9 0.1 0.1 1"/>
    </body>
  </worldbody>

  <equality>
    <!-- Keeps the G1 upright in place -->
    <weld body1="pelvis"/>

    <!-- Holds the apple on top of the open left palm -->
    <weld name="left_hand_weld" body1="apple" body2="left_wrist_yaw_link" relpose="-0.13 0.045 0 1 0 0 0" active="true"/>

    <!-- Catches and holds the apple firmly on top of the open right palm -->
    <weld name="right_hand_weld" body1="apple" body2="right_wrist_yaw_link" relpose="-0.13 -0.045 0 1 0 0 0" solref="0.02 1" active="false"/>
  </equality>
</mujoco>